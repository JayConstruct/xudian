      "major": 1,
      "handler": "saveCourse",
      "kind": "command",
      "input": {
        "type": "object"
      },
      "output": {
        "type": "object"
      },
      "confirmation": "host"
    },
    {
      "id": "schedule.change.save",
      "major": 1,
      "handler": "saveChange",
      "kind": "command",
      "input": {
        "type": "object"
      },
      "output": {
        "type": "object"
      },
      "confirmation": "host"
    },
    {
      "id": "schedule.entity.delete",
      "major": 1,
      "handler": "deleteEntity",
      "kind": "command",
      "input": {
        "type": "object"
      },
      "output": {
        "type": "object"
      },
      "confirmation": "host"
    },
    {
      "id": "schedule.backup.export",
      "major": 1,
      "handler": "exportBackup",
      "kind": "query",
      "input": {
        "type": "object"
      },
      "output": {
        "type": "object"
      },
      "confirmation": "host"
    },
    {
      "id": "schedule.query.todayFeed",
      "major": 1,
      "handler": "queryTodayFeed",
      "kind": "query",
      "input": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string"
          }
        }
      },
      "output": {
        "type": "object"
      }
    },
    {
      "id": "schedule.demo.create",
      "major": 1,
      "handler": "createDemo",
      "kind": "command",
      "input": {
        "type": "object"
      },
      "output": {
        "type": "object"
      },
      "confirmation": "host"
    },
    {
      "id": "schedule.query.busy",
      "major": 1,
      "handler": "queryBusy",
      "kind": "query",
      "input": {
        "type": "object",
        "required": [
          "startDate",
          "endDate"
