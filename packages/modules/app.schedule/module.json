    },
    {
      "id": "courses",
      "schema": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "indexes": [
        {
          "id": "timetable",
          "fields": [
            "timetableId"
          ]
        }
      ]
    },
    {
      "id": "meetings",
      "schema": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "indexes": [
        {
          "id": "timetable",
          "fields": [
            "timetableId"
          ]
        }
      ]
    },
    {
      "id": "occurrenceChanges",
      "schema": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "indexes": [
        {
          "id": "timetable",
          "fields": [
            "timetableId"
          ]
        }
      ]
    },
    {
      "id": "importSources",
      "schema": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "indexes": [
        {
          "id": "timetable",
          "fields": [
            "timetableId"
          ]
        }
      ]
    },
    {
      "id": "importBatches",
      "schema": {
        "type": "object",
        "required": [
          "id"
