    {
      "id": "app.schedule.timetables",
      "title": "课表管理",
      "icon": "calendar",
      "handler": "render",
      "retainPosition": true,
      "settingsPath": "课表设置"
    },
    {
      "id": "app.schedule.today",
      "title": "今日课程",
      "icon": "calendar",
      "handler": "render",
      "headerMode": "contributed",
      "retainPosition": true
    },
    {
      "id": "app.schedule.occurrence",
      "title": "课程详情",
      "icon": "calendar",
      "handler": "render",
      "headerMode": "contributed",
      "retainPosition": true
    },
    {
      "id": "app.schedule.occurrenceEditor",
      "title": "单次课程编辑",
      "icon": "calendar",
      "handler": "render",
      "headerMode": "contributed"
    },
    {
      "id": "app.schedule.todayFeed",
      "title": "每日课程",
      "icon": "calendar",
      "handler": "renderTodayFeed"
    }
  ],
  "services": [
    {
      "id": "schedule.query.timetables",
      "major": 1,
      "handler": "queryTimetables",
      "kind": "query",
      "input": {
        "type": "object"
      },
      "output": {
        "type": "object"
      }
    },
    {
      "id": "schedule.query.week",
      "major": 1,
      "handler": "queryWeek",
      "kind": "query",
      "input": {
        "type": "object"
      },
      "output": {
        "type": "object"
      },
      "confirmation": "host",
      "tool": {
        "description": "schedule.query.week"
      }
    },
    {
      "id": "schedule.query.today",
      "major": 1,
      "handler": "queryToday",
      "kind": "query",
      "input": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string"
          }
        }
      },
      "output": {
        "type": "object"
      },
      "confirmation": "host",
      "tool": {
        "description": "schedule.query.today"
      }
    },
