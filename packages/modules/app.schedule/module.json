{
  "formatVersion": 3,
  "manifest": {
    "id": "app.schedule",
    "name": "大学课表",
    "version": "1.18.1",
    "hostApi": "^1.56.0",
    "dataVersion": 1,
    "permissions": [
      "ui",
      "files",
      "clock.today"
    ],
    "dependencies": [],
    "description": "管理学期、作息、课程、调课记录与多个课表，支持导入和备份。",
    "author": "JayConstruct"
  },
  "entryPoint": "main.js",
