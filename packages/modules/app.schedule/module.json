        "menu": [
          "切换课表",
          "回到本周",
          "今日课程",
          "课表设置",
          "显示设置"
        ],
        "assistant": true
      }
    },
    {
      "id": "app.schedule.settings",
      "title": "课表设置",
      "icon": "calendar",
      "handler": "render",
      "retainPosition": true,
      "entry": {
        "id": "app.schedule.settings.entry",
        "opening": "detail",
        "placement": "settings"
      },
      "menuSourcePage": "app.schedule.home",
      "settingsLabels": [
        "课表管理",
        "学期设置",
        "作息设置",
        "显示设置",
        "导入与备份"
