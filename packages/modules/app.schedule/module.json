          {
            "column": "tue",
            "start": 2,
            "end": 4,
            "title": "大学英语",
            "subtitle": "综合楼 203"
          },
          {
            "column": "wed",
            "start": 0,
            "end": 2,
            "title": "线性代数",
            "subtitle": "教学楼 302"
          },
          {
            "column": "thu",
            "start": 2,
            "end": 4,
            "title": "程序设计",
            "subtitle": "实验楼"
          },
          {
            "column": "fri",
            "start": 0,
            "end": 2,
            "title": "大学物理",
            "subtitle": "理科楼"
          }
