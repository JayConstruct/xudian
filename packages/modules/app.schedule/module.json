      "id": "app.schedule.imports",
      "title": "导入与备份",
      "icon": "calendar",
      "handler": "render",
      "retainPosition": true,
      "slots": [
        {
          "id": "importers",
          "label": "教务导入",
          "kind": "entries",
          "public": true
        }
