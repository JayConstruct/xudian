      "title": "学期设置",
      "icon": "calendar",
      "handler": "render",
      "retainPosition": true,
      "settingsPath": "课表设置"
    },
    {
      "id": "app.schedule.periods",
      "title": "作息设置",
      "icon": "calendar",
      "handler": "render",
      "retainPosition": true,
      "settingsPath": "课表设置"
