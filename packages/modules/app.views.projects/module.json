{
  "formatVersion": 3,
  "manifest": {
    "id": "app.views.projects",
    "name": "项目",
    "version": "1.1.1",
    "hostApi": "^1.6.0",
    "dataVersion": 1,
    "permissions": [
      "ui",
      "clock.today",
      "services.query:app.tasks/task.list@1",
      "services.query:app.tasks/task.get@1",
      "services.query:app.tasks/project.list@1",
      "services.command:app.tasks/project.create@1",
      "services.command:app.tasks/task.create@1",
      "services.command:app.tasks/task.updateFields@1",
      "services.command:app.tasks/task.setCompleted@1",
      "extensions.command:app.tasks/tasks"
    ],
    "dependencies": [
      "app.tasks"
    ],
    "defaultInstall": true,
    "description": "按项目查看任务与项目进度。",
    "author": "JayConstruct"
  },
  "entryPoint": "main.js",
  "pages": [
    {
      "id": "app.views.projects.page",
      "title": "项目",
      "icon": "projects",
      "handler": "render",
      "entry": {
        "id": "projects",
        "opening": "workspace",
        "placement": "main",
        "order": 2
      }
    }
  ],
  "collections": [],
  "services": []
}
