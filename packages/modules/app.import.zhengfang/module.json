{
  "formatVersion": 3,
  "manifest": {
    "id": "app.import.zhengfang",
    "name": "正方教务导入（通用）",
    "version": "1.0.1",
    "hostApi": "^1.8.0",
    "dataVersion": 1,
    "permissions": [
      "ui",
      "browser.capture",
      "services.query:app.import.shiguang/shiguang.bridge.compile@1"
    ],
    "dependencies": [
      {
        "moduleId": "app.import.shiguang",
        "version": "^1.1.0"
      }
    ],
    "description": "通过浏览器采集正方教务课表，调用拾光兼容模块导入大学课表。",
    "author": "JayConstruct"
  },
  "entryPoint": "main.js",
  "collections": [],
  "services": [],
  "pages": [
    {
      "id": "app.import.zhengfang.home",
      "title": "正方教务导入（通用）",
      "icon": "calendar",
      "handler": "render",
      "retainPosition": true,
      "entries": [
        {
          "id": "app.import.zhengfang.settings",
          "opening": "detail",
          "placement": "settings"
        },
        {
          "id": "app.import.zhengfang.importer",
          "opening": "detail",
          "placement": "page",
          "targetPageId": "app.schedule.imports",
          "slotId": "importers"
        }
      ]
    }
  ]
}
