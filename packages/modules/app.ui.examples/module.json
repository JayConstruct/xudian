    },
    {
      "id": "app.ui.examples.demo.priority",
      "title": "单项选择",
      "handler": "render",
      "retainPosition": true
    },
    {
      "id": "app.ui.examples.demo.tags",
      "title": "多项选择",
      "handler": "render",
      "retainPosition": true
    },
    {
      "id": "app.ui.examples.demo.toggle",
