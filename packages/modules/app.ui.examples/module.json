{
  "formatVersion": 3,
  "manifest": {
    "id": "app.ui.examples",
    "name": "UI 示例",
    "version": "1.4.2",
    "hostApi": "^1.15.0",
    "dataVersion": 1,
    "permissions": [
      "ui",
      "clock.today"
    ],
    "dependencies": [],
    "defaultInstall": false,
    "description": "分类浏览真实 UI、控件与动画，查看调用方式并固定常用演示。",
    "author": "JayConstruct"
  },
  "entryPoint": "main.js",
  "collections": [],
  "services": [],
  "pages": [
    {
      "id": "app.ui.examples.page",
      "title": "UI 示例",
      "handler": "render",
      "retainPosition": true,
      "entry": {
        "id": "app.ui.examples.entry",
        "opening": "workspace",
        "placement": "hidden"
      }
    },
    {
      "id": "app.ui.examples.composition",
      "title": "页面槽位示例",
      "kind": "container",
      "handler": "render",
      "retainPosition": true,
      "entry": {
        "id": "app.ui.examples.compositionEntry",
        "opening": "detail",
        "placement": "hidden"
      },
      "slots": [
        {
          "id": "actions",
          "label": "本模块入口",
          "kind": "entries"
        },
        {
          "id": "tabs",
          "label": "公开页签",
          "kind": "tabs",
          "public": true
        },
        {
          "id": "sections",
          "label": "公开纵向内容",
          "kind": "sections",
          "public": true
        }
      ]
    },
    {
      "id": "app.ui.examples.local",
      "title": "局部位置示例",
      "handler": "render",
      "retainPosition": true,
      "entry": {
        "id": "app.ui.examples.localEntry",
        "label": "本模块滚动示例",
        "opening": "detail",
        "content": true,
        "placement": "page",
        "targetPageId": "app.ui.examples.composition",
        "slotId": "tabs"
      }
    },
    {
      "id": "app.ui.examples.demo.button",
      "title": "按钮",
      "handler": "render",
      "retainPosition": true
    },
    {
      "id": "app.ui.examples.demo.confirm",
      "title": "确认对话框",
      "handler": "render",
      "retainPosition": true
    },
    {
      "id": "app.ui.examples.demo.entry",
      "title": "普通条目",
      "handler": "render",
      "retainPosition": true
    },
    {
      "id": "app.ui.examples.demo.content",
      "title": "文字、图标与分割线",
      "handler": "render",
      "retainPosition": true
    },
    {
      "id": "app.ui.examples.demo.title",
      "title": "文本输入",
      "handler": "render",
      "retainPosition": true
    },
    {
      "id": "app.ui.examples.demo.notes",
