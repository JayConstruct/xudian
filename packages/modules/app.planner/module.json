        "serviceId": "schedule.query.busy",
        "majorVersion": 1,
        "kind": "query"
      }
    ],
    "description": "快速添加任务、查看图形时间表并预览和撤销整体安排。",
    "author": "JayConstruct"
  },
  "entryPoint": "main.js",
