{
  "formatVersion": 3,
  "manifest": {
    "id": "app.views.today",
    "name": "日程",
    "version": "1.7.1",
    "hostApi": "^1.21.0",
    "dataVersion": 1,
    "permissions": [
      "ui",
      "clock.today",
      "services.query:app.tasks/task.list@1",
      "services.query:app.tasks/task.get@1",
      "services.query:app.tasks/project.list@1",
      "services.command:app.tasks/project.create@1",
      "services.command:app.tasks/task.create@1",
      "services.command:app.tasks/task.updateFields@1",
      "services.command:app.tasks/task.setCompleted@1",
      "extensions.command:app.tasks/tasks",
      "services.query:app.tasks/task.dayCounts@1"
    ],
    "dependencies": [
      {
        "moduleId": "app.tasks",
        "version": "^1.4.0"
      }
    ],
    "defaultInstall": true,
    "description": "按日期汇总任务、课程与各模块提供的日程内容。",
    "author": "JayConstruct"
  },
  "entryPoint": "main.js",
  "pages": [
    {
      "id": "app.views.today.home",
      "title": "日程",
      "icon": "today",
      "handler": "render",
      "entry": {
        "id": "app.views.today.home",
        "opening": "workspace",
        "placement": "main",
        "order": 0
      },
      "kind": "container",
      "slots": [
        {
          "id": "daily",
          "label": "日程内容",
          "kind": "sections",
          "public": true,
          "inline": true
        }
      ],
      "headerMode": "date",
      "initializesRuntimeContext": true
    },
    {
      "id": "app.views.today.overview",
      "title": "日程概览",
      "handler": "render",
      "entry": {
        "id": "app.views.today.overview.feed",
        "label": "日程概览",
        "placement": "page",
        "targetPageId": "app.views.today.home",
        "slotId": "daily",
        "content": true,
        "order": -100
      }
    },
    {
      "id": "app.views.today.tasks",
      "title": "日程任务",
      "icon": "today",
      "handler": "render",
      "entry": {
        "id": "app.views.today.tasks.feed",
        "label": "日程任务",
        "placement": "page",
        "targetPageId": "app.views.today.home",
        "slotId": "daily",
        "content": true,
        "order": 100
      }
    }
  ],
  "collections": [],
  "services": []
}
