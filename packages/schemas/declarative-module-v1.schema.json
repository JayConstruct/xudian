{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xudian.app/schemas/declarative-module-v1.schema.json",
  "title": "Xudian Executable Declarative Module v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "manifest"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "manifest": {
      "$ref": "#/$defs/manifest"
    },
    "pages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/page"
      }
    },
    "views": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/view"
      }
    },
    "fields": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/field"
      }
    },
    "templates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/template"
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "layouts": {
      "type": "array",
      "maxItems": 0
    }
  },
  "$defs": {
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "coreApi"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "coreApi": {
          "type": "string",
          "minLength": 1
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "requiresCapabilities": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "description": {
          "type": "string"
        },
        "author": {
          "type": "string"
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "view"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/resourceId"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "view": {
          "$ref": "#/$defs/resourceId"
        },
        "icon": {
          "type": "string"
        },
        "selectedIcon": {
          "type": "string"
        },
        "quickAdd": {
          "type": "boolean"
        },
        "quickAddDefaults": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/resourceId"
        },
        "source": {
          "const": "task.list"
        },
        "filter": {
          "type": "object"
        },
        "emptyText": {
          "type": "string"
        },
        "showFields": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "type"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/resourceId"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "text",
            "number",
            "boolean",
            "date",
            "datetime",
            "select",
            "multiSelect"
          ]
        },
        "config": {
          "type": "object",
          "properties": {
            "options": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "select",
                  "multiSelect"
                ]
              }
            }
          },
          "then": {
            "required": [
              "config"
            ],
            "properties": {
              "config": {
                "required": [
                  "options"
                ]
              }
            }
          }
        }
      ]
    },
    "resourceId": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9_-]*$"
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "tasks"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/resourceId"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "project": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/templateTask"
          }
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/templateParameter"
          },
          "uniqueItems": false
        }
      }
    },
    "templateTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "title"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/resourceId"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "parentKey": {
          "$ref": "#/$defs/resourceId"
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "dueDate": {
          "type": "string"
        },
        "plannedDate": {
          "type": "string"
        },
        "fields": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/resourceId"
          }
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "event",
        "actions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/resourceId"
        },
        "title": {
          "type": "string"
        },
        "event": {
          "enum": [
            "task.created",
            "task.updated",
            "task.completed",
            "task.reopened",
            "project.created"
          ]
        },
        "condition": {
          "type": "object"
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/ruleAction"
          }
        }
      }
    },
    "ruleAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command"
      ],
      "properties": {
        "command": {
          "enum": [
            "task.create",
            "task.updateFields",
            "task.setCompleted",
            "project.create",
            "field.set",
            "field.clear"
          ]
        },
        "payload": {
          "type": "object"
        }
      }
    },
    "templateParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "type"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/resourceId"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "text",
            "number",
            "boolean",
            "date",
            "datetime",
            "select",
            "multiSelect"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "default": {},
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "select",
                  "multiSelect"
                ]
              }
            }
          },
          "then": {
            "required": [
              "options"
            ]
          }
        }
      ]
    }
  }
}
