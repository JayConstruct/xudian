{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScheduleImportDraft v1",
  "type": "object",
  "required": [
    "draftVersion",
    "scope",
    "adapterVersion",
    "complete",
    "timetable",
    "courses",
    "meetings"
  ],
  "properties": {
    "draftVersion": {
      "const": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "adapterVersion": {
      "type": "string",
      "minLength": 1
    },
    "complete": {
      "type": "boolean"
    },
    "timetable": {
      "type": "object",
      "required": [
        "name",
        "firstMonday",
        "totalWeeks",
        "timezone",
        "displayWeekStart",
        "periods"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "firstMonday": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "totalWeeks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "timezone": {
          "type": "string"
        },
        "displayWeekStart": {
          "enum": [
            1,
            7
          ]
        },
        "periods": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "number",
              "start",
              "end"
            ],
            "properties": {
              "number": {
                "type": "integer",
                "minimum": 1
              },
              "start": {
                "type": "string"
              },
              "end": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "courses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "sourceId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      }
    },
    "meetings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "courseId",
          "weekday",
          "startPeriod",
          "endPeriod",
          "weeks"
        ],
        "properties": {
          "sourceId": {
            "type": "string"
          },
          "courseId": {
            "type": "string"
          },
          "weekday": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          },
          "startPeriod": {
            "type": "integer",
            "minimum": 1
          },
          "endPeriod": {
            "type": "integer",
            "minimum": 1
          },
          "weeks": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "uniqueItems": true
          }
        }
      }
    },
    "occurrenceChanges": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
