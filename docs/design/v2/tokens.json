{
  "formatVersion": 1,
  "metadata": {
    "name": "V2 visual design baseline",
    "status": "design-only-not-implemented",
    "runtimeConfiguration": false,
    "source": "Screenshot references S01-S10, S13-S14 and product text",
    "sourceIndex": "SCREENSHOT_INDEX.md",
    "valuesOrigin": "Proposed V2 design values, not screenshot measurements",
    "units": { "dimension": "dp", "fontSize": "sp", "duration": "ms" },
    "theme": "light"
  },
  "color": {
    "background": "#F7F7F4",
    "surface": "#FFFFFF",
    "primary": "#5965A8",
    "onPrimary": "#FFFFFF",
    "selected": "#E9EBF5",
    "onSelected": "#5965A8",
    "text": "#25272E",
    "muted": "#666B78",
    "divider": "#E1E3E9",
    "controlBorder": "#858A96",
    "focus": "#5965A8",
    "scrim": { "color": "#000000", "opacity": 0.4 },
    "semantic": {
      "success": { "foreground": "#21633F", "background": "#E7F3EB" },
      "warning": { "foreground": "#7A4B0C", "background": "#FFF3DB" },
      "danger": { "foreground": "#A52A35", "background": "#FCEBED" },
      "information": { "foreground": "#255C8A", "background": "#E8F2FA" }
    },
    "category": {
      "blue": { "foreground": "#255C8A", "background": "#E8F2FA" },
      "green": { "foreground": "#3F6244", "background": "#EDF3E9" },
      "purple": { "foreground": "#63518C", "background": "#F0EBF7" },
      "brown": { "foreground": "#73543A", "background": "#F5EFE7" }
    }
  },
  "typography": {
    "fontFamily": "platform-default-with-cjk-fallback",
    "pageTitle": { "size": 28, "weight": 700, "lineHeight": 1.25 },
    "sectionTitle": { "size": 20, "weight": 600, "lineHeight": 1.25 },
    "body": { "size": 16, "weight": 400, "lineHeight": 1.5 },
    "supporting": { "size": 14, "weight": 400, "lineHeight": 1.5 },
    "compactTime": { "size": 12, "weight": 400, "lineHeight": 1.5 },
    "emphasisWeight": 600,
    "allowSystemTextScaling": true,
    "validationScaleFactors": [1.0, 1.3, 2.0]
  },
  "spacing": {
    "scale": [4, 8, 12, 16, 24, 32],
    "pageHorizontal": 20,
    "cardPadding": 16,
    "navigationOuter": 12,
    "contentClearanceAfterNavigation": 12
  },
  "radius": { "control": 16, "card": 20, "sheet": 28, "capsule": "half-actual-height" },
  "size": { "icon": 24, "minimumHitTarget": 48, "minimumPrimaryButtonHeight": 52, "minimumNavigationHeight": 72 },
  "shadow": {
    "overlay": { "color": "#25272E", "opacity": 0.08, "offsetX": 0, "offsetY": 8, "blur": 24, "spread": 0 },
    "staticCard": "none"
  },
  "layout": {
    "minimumValidationWidth": 320,
    "mediumMinWidth": 600,
    "expandedMinWidth": 840,
    "formMaxWidth": 560,
    "readingMaxWidth": 720,
    "minimumNavigationRailWidth": 80,
    "sheetMaxAvailableHeightFraction": 0.9,
    "safeArea": "respect-system-insets",
    "keyboard": "hide-primary-navigation-and-keep-focused-input-visible",
    "scrollEndInset": "actual-navigation-occlusion-plus-content-clearance"
  },
  "navigation": {
    "defaultDestinations": ["today", "planner", "schedule", "modules"],
    "defaultLabels": ["今天", "规划", "课表", "模块"],
    "keepDefaultDestinationsReachable": true,
    "clipOverflowingDestinations": false,
    "selectionIdentity": "stable-destination-id",
    "mapHiddenCurrentDestinationToAnother": false,
    "largeText": {
      "allowHeightGrowth": true,
      "allowTwoLineLabels": true,
      "compactHorizontalItemPadding": true,
      "shrinkSystemFontScale": false
    }
  },
  "motion": {
    "duration": { "feedback": 120, "stateChange": 180, "navigationAndSheet": 260 },
    "easing": { "enterAndState": [0.2, 0, 0, 1], "exit": [0.4, 0, 1, 1] },
    "continuousGesture": "direct-input-following",
    "reducedMotion": { "spatialDuration": 0, "maximumOpacityDuration": 80, "decorativeLoops": false }
  },
  "accessibility": {
    "minimumTextContrast": 4.5,
    "minimumEssentialControlContrast": 3.0,
    "colorOnlyStatus": false,
    "restoreFocusAfterOverlay": true,
    "backgroundInteractiveDuringModal": false
  }
}
